{
  "name": "mbots",
  "version": "1.0.2",
  "description": "Mbots — 多账号工作台。每个账号独立会话分区，单窗口秒切，后台自动休眠省内存。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "author": "dimerll",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimerll/mbots.git"
  },
  "homepage": "https://github.com/dimerll/mbots#readme",
  "bugs": {
    "url": "https://github.com/dimerll/mbots/issues"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.local.mbots",
    "productName": "Mbots",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "app.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mbots",
      "artifactName": "Mbots-Setup.exe"
    }
  }
}
